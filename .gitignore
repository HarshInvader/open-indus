# Proposed .gitignore for the public repo. Rename to .gitignore after the
# owner has worked through PUBLISHING_CHECKLIST.md. Nothing here deletes files.
# /data/ stays out in full: data/splits*.json lists whole sign texts, not IDs.

# --- Environments, caches, binaries -------------------------------------
.venv/
__pycache__/
*.pyc
*.pkl
*.npz
*.npy
*.zip
.DS_Store
*.log
*.err
board/compute.lock

# --- Private --------------------------------------------------------------
# Draft emails with addresses and named contacts
/docs/outreach/
# Live team board: agent notes, local paths, outreach status
/board/board.db
/board/board.db-shm
/board/board.db-wal
# Agent planning files and briefs that contain local paths
/experiments/fable52_plan*
/docs/fable_brief*.md

# --- Third-party corpora and downloads (licence unknown or not ours) ----
/sources/
/data/
experiments/*/raw/
experiments/*/ext/
experiments/*/data/
experiments/*/work/
# Nested clones of other people's repositories
**/.git/

# --- Images derived from scanned books, CISI pages or rendered fonts ----
experiments/**/*.png
experiments/**/*.jpg
experiments/**/*.jpeg
experiments/**/*.tif
experiments/**/*.tiff
experiments/**/*.pdf
# Keep only the 1931-1940 excavation-report crops and code-drawn result figures.
# The crops are public domain in India (government works, 60 years from
# publication). Their US status is uncertain: the 1938 and 1940 reports may
# carry restored US copyright to 2033 and 2035. See LICENSING.md and settle it
# in PUBLISHING_CHECKLIST.md before publishing.
!experiments/plate_corpus/crops/plate_*.png
!experiments/decipherability/phase_diagram.png
# Chanhu-daro crops come from Mackay 1943, outside 1931-1940: keep them out
experiments/plate_corpus/crops/plate_CE_*
# Never publish anything from the CISI volumes (1987 onward, in copyright)
**/cisi_*
experiments/iconography/
experiments/scene_text/
results/top120_signs.png

# --- Superseded or local-only material ---------------------------------
# Older draft of the website (replaced by site/); uses wording the project
# no longer uses. Delete this line if the owner wants it published.
/docs/site/

# --- Site build output is kept; its sources stay small ------------------
# site/repo_files/ holds the templates for README_PUBLIC_DRAFT.md,
# CONTRIBUTING.md and the other GitHub files; it is published on purpose.

# --- Added at first commit ----------------------------------------------
node_modules/
.wrangler/
.env
.env.*
*.db-shm
*.db-wal
/tmp/
/docs/OVERVIEW.html

# Local downloads made by datasets/fetch.py
/datasets/local/

# harappa.com page copies and paper text extracts (not ours to republish)
experiments/harappa_com/evidence/
experiments/source_sweep/evidence/
site/qa/

# retrain: split files hold M77 sign sequences (not published); probability arrays are large
experiments/bench_restoration/out/splits/
experiments/bench_restoration/out/runs/*/*.npy
docs/paper/submission/

# mismatch_study: third-party corpora (licenses in raw_real/SOURCES.md; Ugaritic CUC is CC BY-NC) stay local
experiments/mismatch_study/raw_real/*
!experiments/mismatch_study/raw_real/SOURCES.md
experiments/mismatch_study/out/
experiments/mismatch_study/*.log

# carver_text: derived table holds Jamison attributes (thesis, all rights reserved) and ICIT readings; stays local
experiments/carver_text/out/
.venv-vision/

# ensemble_rehearsal: blind packets hold CDLI drawings and corpus contexts
experiments/ensemble_rehearsal/packets/

# Local-only licensed material (Scott key, Mukhopadhyay glyphs): never commit
/.local/

# certify_size_curve: small CC0 Oracc files (sign list zip, derived lexicon); see raw/README.md
!experiments/certify_size_curve/raw/
!experiments/certify_size_curve/raw/ogsl/ogsl.zip
!experiments/anchor_crossread/raw/
!experiments/anchor_crossread/raw/ogsl/ogsl.zip
# crossread_coins: BIGR type export (ODbL 1.0, attribution in raw/bigr/README.md); see docs/prereg/crossread_coins.md
!experiments/crossread_coins/raw/
!experiments/crossread_coins/raw/bigr/
!experiments/crossread_coins/raw/bigr/query.csv
!experiments/crossread_coins/raw/bigr/README.md

# --- Regenerable or local-only outputs (2026-11-26) -------------------------
/experiments/guess_rehearsal/packets/
/experiments/meaning_calibration/claims_input/A_inventory.txt
/experiments/meaning_calibration/claims_input/B_inventory.json
/experiments/stamp_detector/out/lists/
/experiments/search_scaling/out/log.txt
/experiments/*.raw.txt
# Unsealed draft preregs closed at their gates; kept unpublished (atlas 10b.20, 10b.21)
/docs/prereg/disguised_tournament.md
/docs/prereg/sign_type_classifier.md

# raj_check: working copy of Raj v0.7 REP-1 holds the non-redistributable lipi corpus
experiments/raj_check/work/
experiments/raj_check/stage2/agents/names_in.jsonl
